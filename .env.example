# Generate your own secret; the development database and mock mail folder are local.
JWT_SECRET=replace-with-a-long-random-value
DATABASE_PATH=./data/sqlite.db
MOCK_EMAIL_FOLDER=./data/mock-emails
# For real delivery remove MOCK_EMAIL_FOLDER and configure these settings.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
