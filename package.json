{
  "name": "shift-distributor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_PATH=:memory: tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node ./scripts/migrate.cjs",
    "db:restore": "node ./scripts/restore.cjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-query-devtools": "^5.83.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "4.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.535.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.14",
    "react": "19.3.0",
    "react-day-picker": "^9.8.1",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3",
    "tsx": "^4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
